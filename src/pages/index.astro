---
import Button from "../components/Button.astro";
import MediumCard from "../components/MediumCard.astro";
import SmallCard from "../components/SmallCard.astro";
import Tag from "../components/Tag.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";
import "../styles/typography.css";
import "../styles/colors.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout>
	<PageLayout>
		<div style="background-color: #eee; padding: 16px 64px;">
			<body class="H1"> Navigation Bar Placeholder </body>
		</div>
		<div
			style="padding: 64px; height: 352px; align-items: center; display: flex; justify-content: center;"
		>
			<h1 class="H1" style="text-align: center;">
				Product designer and front-end developer with a focus on
				consumer-facing apps & design systems
			</h1>
		</div>
		<div>
			<grid
				style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; padding: 32px 64px 16px 64px;"
			>
				<MediumCard
					showMeasurableMetric={true}
					measurableMetricIcon="trending_down"
					measurableMetric="Reducing congnitive load"
					---
					title="Improving communication to the public during disaster events"
					tags={["Type", "Area", "Role", "Year"]}
					---
					showDesktopImage={true}
					showMobileImages={false}
					desktopImage="/images/desktop.png"
					mobileImages={[
						"/images/mobile-1.png",
						"/images/mobile-2.png",
					]}
					---
					cardBackgroundHover="var(--bg-blue)"
					tagBackgroundHover="var(--bg-blue-hover)"
				/>
				<MediumCard
					measurableMetric="Saving time for 1000+ fieldworkers"
					measurableMetricIcon="bolt"
					---
					title="Led the creation of an internal app introducing efficiencies in timesheets"
					tags={["Type", "Area", "Role", "Year"]}
					---
					showDesktopImage={false}
					showMobileImages={true}
					desktopImage="/images/desktop.png"
					mobileImages={[
						"/images/mobile-1.png",
						"/images/mobile-2.png",
					]}
					---
					cardBackgroundHover="var(--bg-default-hover)"
					tagBackgroundHover="var(--bg-blue-hover)"
				/>
				<MediumCard
					showMeasurableMetric={false}
					measurableMetric=""
					---
					title="Helping young adults better organise their food knowledge"
					tags={["Type", "Area", "Role", "Year"]}
					---
					showDesktopImage={false}
					showMobileImages={true}
					desktopImage="/images/desktop.png"
					mobileImages={[
						"/images/mobile-1.png",
						"/images/mobile-2.png",
					]}
					---
					cardBackgroundHover="var(--bg-default-hover)"
					tagBackgroundHover="var(--bg-blue-hover)"
				/>
				<MediumCard
					measurableMetric="+97% user duration"
					measurableMetricIcon="trending_up"
					---
					title="Building a clearer Portfolio to showcase design & dev skills"
					tags={["Type", "Area", "Role", "Year"]}
					---
					showDesktopImage={true}
					showMobileImages={false}
					desktopImage="/images/desktop.png"
					mobileImages={[
						"/images/mobile-1.png",
						"/images/mobile-2.png",
					]}
					---
					cardBackgroundHover="var(--bg-default-hover)"
					tagBackgroundHover="var(--bg-blue-hover)"
				/>
				<SmallCard
					icon="celebration"
					title="Fun"
					tags={["Recently Added"]}
					description="Description of the link"
				/>
				<SmallCard
					icon="devices"
					title="Currently Working on"
					description="Description of the link"
				/>
				<SmallCard
					icon="lightbulb"
					title="Ideas"
					description="Description of the link"
				/>
				<SmallCard
					icon="inventory_2"
					title="Archived Projects"
					description="Description of the link"
				/>
			</grid>
		</div>
		<div style="background-color: #eee; padding: 16px 64px;">
			<body class="H1"> Footer Bar Placeholder </body>
		</div>
	</PageLayout>
</BaseLayout>

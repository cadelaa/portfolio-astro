---
import Button from "../components/Button.astro";
import Navigation from "../components/Navigation.astro";
import MediumCard from "../components/MediumCard.astro";
import SmallCard from "../components/SmallCard.astro";
import Footer from "../components/Footer.astro";
import Tag from "../components/Tag.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../layouts/Hero.astro";
import ProjectGrid from "../layouts/ProjectLayouts/projectgrid.astro";
import "../styles/typography.css";
import "../styles/colors.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout>
	<PageLayout>
		<Navigation
			hasLogo={true}
			---
			hasBackLink={false}
			backLabel="Back"
			backLink="/"
		/>

		<Hero
			title="Product designer and front-end developer with a focus on consumer-facing apps & design systems"
			sticky
		/>
		<ProjectGrid>
			<MediumCard
				link="../projects/disasterhub/design/"
				---
				showMeasurableMetric={true}
				measurableMetricIcon="trending_down"
				measurableMetric="Reducing congnitive load"
				---
				title="Improving communication to the public during disaster events"
				tags={[
					"Redesign",
					"Disaster Management",
					"Product Designer",
					"2025",
				]}
				---
				showDesktopImage={true}
				desktopImage="/src/assets/images/disasterhub.png"
				desktopImageAlt="DisasterHub homepage screenshot"
				---
				showMobileImages={false}
				mobileImages={[]}
				mobileImageAlt=""
				---
				cardBackgroundHover="var(--bg-orange)"
				tagBackgroundHover="var(--bg-orange-hover)"
			/>

			<MediumCard
				link="../projects/nexus/design/"
				---
				measurableMetric="Saving time for 1000+ fieldworkers"
				measurableMetricIcon="bolt"
				---
				title="Led the creation of an internal app introducing efficiencies in timesheets"
				tags={[
					"App",
					"Internal",
					"Product Designer & Developer",
					"2025",
				]}
				---
				showDesktopImage={false}
				desktopImage=""
				desktopImageAlt=""
				---
				showMobileImages={true}
				mobileImages={[
					"/src/assets/images/nexus-1.png",
					"/src/assets/images/nexus-2.png",
				]}
				mobileImageAlt=""
				---
				cardBackgroundHover="var(--bg-council-blue)"
				tagBackgroundHover="var(--bg-council-blue-hover)"
			/>

			<MediumCard
				link="../projects/culina/design/"
				---
				showMeasurableMetric={false}
				measurableMetric=""
				---
				title="Helping young adults better organise their food knowledge"
				tags={[
					"App Concept",
					"Health & Fitness",
					"Product Designer",
					"2025",
				]}
				---
				showDesktopImage={false}
				desktopImage=""
				desktopImageAlt=""
				---
				showMobileImages={true}
				mobileImages={[
					"/src/assets/images/culina-1.png",
					"/src/assets/images/culina-2.png",
				]}
				mobileImageAlt=""
				---
				cardBackgroundHover="var(--bg-blue)"
				tagBackgroundHover="var(--bg-blue-hover)"
			/>

			<MediumCard
				link="../projects/portfolio/design/"
				---
				measurableMetric="+97% user duration"
				measurableMetricIcon="trending_up"
				---
				title="Building a clearer Portfolio to showcase design & dev skills"
				tags={[
					"Website",
					"Portfolio",
					"Product Designer & Developer",
					"2025",
				]}
				---
				showDesktopImage={true}
				desktopImage="/src/assets/images/about.png"
				desktopImageAlt="About page screenshot"
				---
				showMobileImages={false}
				mobileImages={["/images/mobile-1.png", "/images/mobile-2.png"]}
				mobileImageAlt=""
				---
				cardBackgroundHover="var(--bg-indigo)"
				tagBackgroundHover="var(--bg-indigo-hover)"
			/>

			<SmallCard
				link="/fun/"
				icon="celebration"
				title="Fun"
				tags={["Recently Added"]}
				description="Stuff I enjoy working on that isn't related to being a product designer / front-end developer."
			/>

			<SmallCard
				link="../projects/currently-working-on/"
				icon="devices"
				title="Currently Working on"
				description="A timeline of all my projects I am working on, have worked on, and if they are still in progress, cancelled or paused."
			/>

			<SmallCard
				link="../projects/ideas/"
				icon="lightbulb"
				title="Ideas"
				description="Smaller UI/UX redesigns, experiments, motion etc. Basically my playground of random stuff."
			/>

			<SmallCard
				link="../projects/archived/"
				icon="inventory_2"
				title="Archived Projects"
				description="Older projects that no longer best represent my skills & just older versions of current projects in my portfolio."
			/>
		</ProjectGrid>
		<Footer />
	</PageLayout>
</BaseLayout>

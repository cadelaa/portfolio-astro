---
import {
    Hero,
    ProjectGrid,
    MediumCard,
    SmallCard,
    Footer,
    Navigation,
    BaseLayout,
    PageLayout,
    Overview,
    Default,
    Showcase,
    Button,
    PageNav,
    FeatureShowcase,
} from "../../../components";

import "../../../styles/typography.css";
import "../../../styles/colors.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout>
    <PageLayout>
        <Navigation hasLogo={false} hasBackLink={true} backLink="/" />
        <div>
            <Hero
                title="Culina is a concept app aiming to provide young adults the tools to better organise meal plans, save recipes in a personal journal, and manage grocery lists."
            />
            <div
                style="padding: var(--space-16) 0; display: flex; gap: var(--space-8);"
            >
                <Button type="primary" label="Design" link="" />
                <Button
                    type="secondary"
                    label="Development"
                    link="../development/"
                    disabled={true}
                />
            </div>

            <PageNav
                links={[
                    { label: "Overview", href: "#overview" },
                    { label: "Problem", href: "#problem" },
                    { label: "Solution", href: "#solution" },
                    { label: "Wireframing", href: "#wireframing" },
                    { label: "Final Design", href: "#final-design" },
                    { label: "Outcome", href: "#outcome" },
                ]}
            />

            <div class="hero-container" style="padding: var(--space-16) 0;">
                <div
                    class="hero-image"
                    style="padding: var(--space-64); display: flex; gap: var(--space-8); background: var(--bg-default); height: 700px; border: 1px solid var(--border-subtle); border-radius: var(--radius-8);"
                >
                    <span>Main/hero image here</span>
                </div>
            </div>

            <Overview
                ID="overview"
                sectionLabel="Overview"
                title="Designing my Portfolio"
                description="Aa"
                role="Product Designer"
                timeframe="2-4 weeks"
                team="Me"
                tools={["Figma"]}
            />

            <FeatureShowcase
                sectionLabel="Recipe Journal"
                tagLabel="Core Feature"
                gifs={[
                    {
                        src: "culina/create-meal.gif",
                        variant: "mobile",
                        title: "Create a Meal",
                    },
                    {
                        src: "culina/add-block.gif",
                        variant: "mobile",
                        title: "Add a Block",
                    },
                    {
                        src: "culina/add-block.gif",
                        variant: "mobile",
                        title: "Add a Block",
                    },
                ]}
            />
        </div>
        <Footer />
    </PageLayout>
</BaseLayout>

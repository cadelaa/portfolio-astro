---
import Button from "../../../components/Button.astro";
import Navigation from "../../../components/Navigation.astro";
import MediumCard from "../../../components/MediumCard.astro";
import SmallCard from "../../../components/SmallCard.astro";
import Footer from "../../../components/Footer.astro";
import Tag from "../../../components/Tag.astro";
import Default from "../../../layouts/ProjectLayouts/default.astro";
import Showcase from "../../../layouts/ProjectLayouts/showcase.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import "../../../styles/typography.css";
import "../../../styles/colors.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout>
    <PageLayout>
        <Navigation
            hasLogo={false}
            ---
            hasBackLink={true}
            backLabel="Back home"
            backLink="/"
        />
        <div>
            <div style="padding: var(--space-64); display: flex;">
                <h1 class="H1">
                    How I rebuilt my portfolio to make it clearer, more
                    consistent, and better showcase both design and development
                    work.
                </h1>
            </div>
            <div
                style="padding: var(--space-16) var(--space-64); display: flex; gap: var(--space-8);"
            >
                <Button type="primary" label="Design" link="" />
                <Button
                    type="secondary"
                    label="Development"
                    link="../development/"
                />
            </div>

            <div
                style="padding: var(--space-16) var(--space-64); display: flex; gap: var(--space-16);"
            >
                <span>Jump links</span>
                <span>Label</span>
                <span>Label</span>
                <span>Label</span>
                <span>Label</span>
                <span>Label</span>
                <span>Label</span>
            </div>

            <div class="hero-container" style="padding: var(--space-64);">
                <div
                    class="hero-image"
                    style="padding: var(--space-64); display: flex; gap: var(--space-8); background: var(--bg-default); height: 700px; border: 1px solid var(--border-subtle); border-radius: var(--radius-8);"
                >
                    <span>Main/hero image here</span>
                </div>
            </div>

            <Default
                sectionLabel="Default"
                title="Title"
                description="Description here.."
            />

            <Showcase
                sectionLabel="Showcase"
                tagLabel="Tag Label"
                title="Title"
                description="Description here.."
                mainShowcaseTitle="Main"
                secondShowcaseTitle="Second"
                thirdShowcaseTitle="Third"
            />

            <div
                style="padding: var(--space-64); display: flex; gap: var(--space-8);"
            >
                <div class="project-overview">
                    <div class="head-content">
                        <div class="Body subtle-label">Overview</div>
                    </div>
                    <div class="main-content">
                        <div class="title">
                            <span class="H4">Title</span>
                        </div>
                        <div class="body-paragraph">
                            <span class="Body subtle-label"
                                >Description here</span
                            >
                        </div>
                    </div>
                    <div class="footer-content">
                        <div class="list-item">
                            <span class="H5">Role</span>
                            <span class="Body subtle-label"
                                >Description here</span
                            >
                        </div>
                        <div class="list-item">
                            <span class="H5">Timeframe</span>
                            <span class="Body subtle-label"
                                >Description here</span
                            >
                        </div>
                        <div class="list-item">
                            <span class="H5">Team</span>
                            <span class="Body subtle-label"
                                >Description here</span
                            >
                        </div>
                        <div class="list-item">
                            <span class="H5">Tools</span>
                            <div class="logo-group">
                                <span>Lo</span>
                                <span>Lo</span>
                                <span>Lo</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div
                style="padding: var(--space-64); display: flex; gap: var(--space-8);"
            >
                <div class="project-overview">
                    <div class="head-content">
                        <div class="Body subtle-label">One Image</div>
                    </div>
                    <div class="main-content">
                        <div class="title">
                            <span class="H4">Title</span>
                        </div>
                        <div class="body-paragraph">
                            <span class="Body subtle-label"
                                >Description here</span
                            >
                        </div>
                    </div>
                    <div class="footer-content">
                        <div class="image-container">
                            <div class="image-placeholder">Image/Gif/Video</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div
            style="padding: var(--space-64); display: flex; gap: var(--space-8);"
        >
            <div class="project-overview">
                <div class="head-content">
                    <div class="Body subtle-label">Showcase</div>
                    <Tag label="Hello" bgColor="var(--bg-default)" />
                </div>
                <div class="main-content">
                    <div class="title">
                        <span class="H4">Title</span>
                    </div>
                    <div class="body-paragraph">
                        <span class="Body subtle-label">Description here</span>
                    </div>
                </div>
            </div>
        </div>
        <Footer />
    </PageLayout>
</BaseLayout>

<style lang="scss">
    .project-overview {
        display: flex;
        flex-direction: column;
        gap: var(--space-16);
        width: 100%;
    }

    .head-content {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: var(--space-8);
    }

    .main-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-bottom: var(--space-4);
    }

    .footer-content {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: var(--space-16);
    }

    .list-item {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .image-container {
        display: flex;
        flex-direction: row;
        max-height: 700px;
        overflow: hidden;
        padding: var(--space-32);
        background: var(--bg-default);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-8);
        gap: var(--space-16);
    }

    .image-placeholder {
        background: var(--bg-default-hover);
        min-height: 900px;
        width: 100%;

        display: flex;
        justify-content: center;
        align-items: center;
    }

    .subtle-label {
        color: var(--text-subtle);
    }
</style>

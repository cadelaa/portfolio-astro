---
import {
    Hero,
    ProjectGrid,
    MediumCard,
    SmallCard,
    Footer,
    Navigation,
    BaseLayout,
    PageLayout,
    Button,
    Tag,
    Overview,
    Default,
    PageNav,
    Showcase,
} from "../../../components";
import "../../../styles/typography.css";
import "../../../styles/colors.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout>
    <PageLayout>
        <Navigation hasLogo={false} --- hasBackLink={true} backLink="/" />
        <Hero title="Nexus Design page" />
        <div
            style="padding: var(--space-16) 0; display: flex; gap: var(--space-8);"
        >
            <Button type="primary" label="Design" link="" />
            <Button
                type="secondary"
                label="Development"
                link="../development/"
                disabled={true}
            />
        </div>
        <PageNav
            links={[
                { label: "Overview", href: "#overview" },
                { label: "Problem", href: "#problem" },
                { label: "Constraints", href: "#constraints" },
                { label: "Approach", href: "#approach" },
                { label: "Insights", href: "#insights" },
                { label: "Design System", href: "#designsystem" },
                { label: "Design Decisions", href: "#designdecisions" },
                { label: "Outcome", href: "#outcome" },
                { label: "Reflections", href: "#reflections" },
            ]}
        />
        <Overview
            ID="overview"
            sectionLabel="Overview"
            title="Title label"
            description="Description label here..."
            role="Product Designer"
            timeframe="2-4 weeks"
            team="Me"
            tools={["Figma", "Jitter"]}
        />

        <Default
            ID="problem"
            sectionLabel="Problem"
            title="Problem label"
            description="Description label here..."
        />

        <Default
            ID="constraints"
            sectionLabel="Constraints"
            title="Constraints label"
            description="Description label here..."
        />

        <Default
            ID="approach"
            sectionLabel="Approach"
            title="Approach label"
            description="Description label here..."
        />

        <Showcase
            sectionLabel="Design Decisions"
            tagLabel="Process"
            title="Why we made these choices"
            columns={2}
            items={[
                {
                    description: "We decided users didn't need...",
                    mobileImage: "foo.png",
                    span: 1,
                },
                {
                    description: "We decided users didn't need...",
                    mobileImage: "foo.png",
                    span: 1,
                },
                {
                    description: "I was told that users only...",
                    mobileImage: "bar.png",
                },
                {
                    description: "After talking with fieldworkers...",
                    mobileImage: "baz.png",
                },
            ]}
        />
        <Footer />
    </PageLayout>
</BaseLayout>

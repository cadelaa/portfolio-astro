---
import {
    Hero,
    ProjectGrid,
    MediumCard,
    SmallCard,
    Footer,
    Navigation,
    BaseLayout,
    PageLayout,
    Button,
    Tag,
    Overview,
    Default,
    PageNav,
    Showcase,
    ImageLayout,
} from "../../../components";
import "../../../styles/typography.css";
import "../../../styles/colors.css";
import {
    timesheetBadgePhone,
    adminPhone,
    jobPreparePhone,
    homepagePhone,
} from "../../../assets/images/projects/nexus/nexus.ts";
import { Image } from "astro:assets";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout>
    <PageLayout>
        <Navigation hasLogo={false} --- hasBackLink={true} backLink="/" />
        <Hero title="Nexus Design page" />
        <div
            style="padding: var(--space-16) 0; display: flex; gap: var(--space-8);"
        >
            <Button type="primary" label="Design" link="" />
            <Button
                type="secondary"
                label="Development"
                link="../development/"
                disabled={true}
            />
        </div>
        <PageNav
            links={[
                { label: "Overview", href: "#overview" },
                { label: "Problem", href: "#problem" },
                { label: "Constraints", href: "#constraints" },
                { label: "Approach", href: "#approach" },
                { label: "Insights", href: "#insights" },
                { label: "Design System", href: "#designsystem" },
                { label: "Design Decisions", href: "#designdecisions" },
                { label: "Outcome", href: "#outcome" },
                { label: "Reflections", href: "#reflections" },
            ]}
        />
        <Overview
            ID="overview"
            sectionLabel="Overview"
            title="Title label"
            description="Description label here..."
            role="Product Designer"
            timeframe="2-4 weeks"
            team="Me"
            tools={["Figma", "Jitter"]}
        />

        <Default
            ID="problem"
            sectionLabel="Problem"
            title="Problem label"
            description="Description label here..."
        >
            <p>Slot here</p>
        </Default>

        <Default
            ID="constraints"
            sectionLabel="Constraints"
            title="Constraints label"
            description="Description label here..."
        />

        <Default
            ID="approach"
            sectionLabel="Approach"
            title="Approach label"
            description="Description label here..."
        />

        <Default
            ID="insights"
            sectionLabel="Insights"
            title="Insights label"
            description="Description label here..."
        />

        <Default
            ID="designsystem"
            sectionLabel="Design System"
            title="Design System label"
            description="Description label here..."
        />

        <Showcase
            ID="designdecisions"
            sectionLabel="Design Decisions"
            tagLabel="Process"
            title="Here are some of the design decisions I made throughout the design process of the app"
            columns={2}
            items={[
                {
                    description:
                        "We decided users didnt need both a successful and negative submission icon and opted just for informing them when there was an issue.",
                    mobileImage: timesheetBadgePhone,
                },
                {
                    description:
                        "Feedback from standups revealed users only need to see the past two months, mainly managers when reviewing timesheets.",
                    mobileImage: adminPhone,
                },
                {
                    description:
                        "After talking with Fieldworkers it was mentioned they could work together on jobs, and so I needed to implement how this would function in app.",
                    mobileImage: jobPreparePhone,
                },
                {
                    description:
                        "Fieldworkers would plan their day based on weather conditions, meaning they needed to see current and future weather conditions.",
                    mobileImage: homepagePhone,
                },
            ]}
        />

        <Default
            ID=""
            sectionLabel="Timesheet screens"
            title="Timesheet screens label"
            description="Description label here..."
        >
            <ImageLayout
                columns={1}
                mobileImages={[{ src: timesheetBadgePhone, alt: "Home" }]}
            />
            <ImageLayout
                columns={2}
                mobileImages={[
                    { src: timesheetBadgePhone, alt: "Home" },
                    { src: timesheetBadgePhone, alt: "Admin" },
                ]}
            />
        </Default>

        <Default
            ID="outcome"
            sectionLabel="Outcome"
            title="Outcome label"
            description="Description label here..."
        />

        <Default
            ID="reflections"
            sectionLabel="Reflections"
            title="Reflections label"
            description="Description label here..."
        />

        <Footer />
    </PageLayout>
</BaseLayout>

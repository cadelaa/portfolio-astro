---
import "../../styles/colors.css";
import "../../styles/spacing.css";
import "../../styles/radius.css";
import "../../styles/typography.css";
import Tag from "../../components/Tag.astro";

export interface Props {
    sectionLabel: string;
    tagLabel: string;

    title: string;
    description: string;

    mainTags?: string[];
    mainShowcaseTitle?: string;
    mainImage?: string;

    showSecondary?: boolean;

    secondTags?: string[];
    secondShowcaseTitle?: string;
    secondImage?: string;

    thirdTags?: string[];
    thirdShowcaseTitle?: string;
    thirdImage?: string;

    ID?: string;
}

const {
    sectionLabel,
    tagLabel,

    title,
    description,

    mainTags = [],
    mainShowcaseTitle,
    mainImage,

    secondTags = [],
    secondShowcaseTitle,
    secondImage,

    thirdTags = [],
    thirdShowcaseTitle,
    thirdImage,

    showSecondary = true, // 👈 default to visible
} = Astro.props;
---

<div class="showcase" id={Astro.props.ID}>
    <div class="head-content">
        <span class="body subtle">{sectionLabel}</span>
        <Tag label={tagLabel} bgColor="var(--bg-default)" />
    </div>
    <div class="main-content">
        <span class="H4">{title}</span>
        <span class="body subtle">{description}</span>
    </div>
    <div class="footer-content">
        <div class="image-container primary-container">
            <div class="image-title">
                <span class="H5">{mainShowcaseTitle}</span>
                <div class="tag-group">
                    {
                        mainTags.map((tag) => (
                            <Tag
                                label={tag}
                                bgColor="var(--bg-default-hover)"
                                tagTextColor="var(--text-primary)"
                            />
                        ))
                    }
                </div>
            </div>
            <div class="image">
                {
                    mainImage && (
                        <img
                            src={`/images/${mainImage}`}
                            alt=""
                            loading="lazy"
                        />
                    )
                }
            </div>
        </div>
        {
            showSecondary && (
                <div class="container-group">
                    <div class="image-container secondary-container">
                        <div class="image-title">
                            <span class="H5">{secondShowcaseTitle}</span>
                            <div class="tag-group">
                                {secondTags.map((tag) => (
                                    <Tag
                                        label={tag}
                                        bgColor="var(--bg-default-hover)"
                                        tagTextColor="var(--text-primary)"
                                    />
                                ))}
                            </div>
                        </div>
                        <div class="image">
                            {secondImage && (
                                <img
                                    src={`/images/${secondImage}`}
                                    alt=""
                                    loading="lazy"
                                />
                            )}
                        </div>
                    </div>

                    <div class="image-container secondary-container">
                        <div class="image-title">
                            <span class="H5">{thirdShowcaseTitle}</span>
                            <div class="tag-group">
                                {thirdTags.map(
                                    (
                                        tag, // 👈 also fixed this bug
                                    ) => (
                                        <Tag
                                            label={tag}
                                            bgColor="var(--bg-default-hover)"
                                            tagTextColor="var(--text-primary)"
                                        />
                                    ),
                                )}
                            </div>
                        </div>
                        <div class="image">
                            {thirdImage && (
                                <img
                                    src={`/images/${thirdImage}`}
                                    alt=""
                                    loading="lazy"
                                />
                            )}
                        </div>
                    </div>
                </div>
            )
        }
    </div>
</div>

<style lang="scss">
    .showcase {
        background-color: var(--bg-page);
        display: flex;
        flex-direction: column;
        padding: var(--space-64) 0;
        gap: var(--space-16);
    }

    .head-content {
        display: flex;
        gap: var(--space-8);
    }

    .main-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    .footer-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-16);
    }

    .container-group {
        display: flex;
        gap: var(--space-16);
        flex: 1;
    }

    .image-title {
        display: flex;
        gap: var(--space-8);
    }

    .image-container {
        display: flex;
        flex-direction: column;
        justify-content: start;
        flex: 1;
        min-height: 0;
        align-items: center;

        background: var(--bg-default);

        gap: var(--space-8);
        padding: var(--space-32);

        border: solid 1px var(--border-subtle);
        border-radius: var(--radius-8);

        overflow: hidden;

        &.primary-container {
            min-height: 700px;
        }

        &.secondary-container {
            min-height: 500px;
        }
    }

    .image {
        position: relative;

        width: 100%;
        height: 500px; // 👈 fixed visual height (adjust as needed)

        background: var(--bg-secondary);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-8);

        overflow: hidden;

        display: flex;
        align-items: center;
        justify-content: center;

        img {
            position: absolute;
            inset: 0;

            width: 100%;
            height: 100%;

            object-fit: cover;
        }
    }

    .subtle {
        color: var(--text-subtle);
    }
</style>

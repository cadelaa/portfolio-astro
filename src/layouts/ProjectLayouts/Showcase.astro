---
import "../../styles/colors.css";
import "../../styles/spacing.css";
import "../../styles/radius.css";
import "../../styles/typography.css";
import Tag from "../../components/Tag.astro";

export interface ShowcaseItem {
    description: string;
    mobileImage?: string;
    desktopImage?: string;
    span?: number; // 1 (default), 2, or 3
}

export interface Props {
    sectionLabel: string;
    tagLabel: string;
    title: string;
    description?: string;
    columns?: 2 | 3;
    items: ShowcaseItem[];
    ID?: string;
}

const {
    sectionLabel,
    tagLabel,
    title,
    description,
    columns = 2,
    items = [],
    ID,
} = Astro.props;
---

<div class="showcase" id={ID} data-columns={columns}>
    <div class="head-content">
        <span class="body subtle">{sectionLabel}</span>
        <Tag label={tagLabel} bgColor="var(--bg-default)" />
    </div>
    <div class="main-content">
        <span class="H4">{title}</span>
        {description && <span class="body subtle">{description}</span>}
    </div>
    <div class="items-grid">
        {
            items.map((item) => (
                <div class="showcase-card" data-span={item.span ?? 1}>
                    <p class="H5 card-description">{item.description}</p>
                    {item.mobileImage && (
                        <div class="card-image card-image--mobile">
                            <img
                                src={`/images/${item.mobileImage}`}
                                alt=""
                                loading="lazy"
                            />
                        </div>
                    )}
                    {item.desktopImage && (
                        <div class="card-image card-image--desktop">
                            <img
                                src={`/images/${item.desktopImage}`}
                                alt=""
                                loading="lazy"
                            />
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</div>

<style lang="scss">
    // --- Mobile first ---

    .showcase {
        display: flex;
        flex-direction: column;
        padding: var(--space-64) 0;
        gap: var(--space-16);
        color: var(--text-primary);
        width: 100%;
    }

    .head-content {
        display: flex;
        gap: var(--space-8);
    }

    .main-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    .items-grid {
        display: grid;
        gap: var(--space-16);
        grid-template-columns: 1fr;
    }

    .showcase-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-16);
        padding: var(--space-24);

        background: var(--bg-default);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-8);

        overflow: hidden;
        min-height: 400px;

        // Span has no effect on mobile — all cards are full width
        &[data-span="2"],
        &[data-span="3"] {
            grid-column: span 1;
            min-height: 400px;
        }
    }

    .card-description {
        color: var(--text-primary);
    }

    .card-image {
        background: var(--bg-default-hover);
        border-radius: var(--radius-8);
        overflow: hidden;

        img {
            display: block;
            border: none;
        }

        &--mobile {
            align-self: center;
            width: 260px;
            max-width: 100%;
            flex-shrink: 0;

            img {
                width: 100%;
                height: auto;
            }
        }

        &--desktop {
            align-self: center;
            max-width: 100%;
            flex-shrink: 0;

            img {
                width: 100%;
                height: auto;
            }
        }
    }

    .subtle {
        color: var(--text-subtle);
    }

    // --- Desktop ---

    @media (min-width: 1120px) {
        .showcase-card {
            padding: var(--space-32);
            min-height: 500px;

            &[data-span="2"] {
                grid-column: span 2;
                min-height: 600px;
            }

            &[data-span="3"] {
                grid-column: span 3;
                min-height: 600px;
            }
        }

        .items-grid {
            grid-template-columns: repeat(2, 1fr);

            .showcase[data-columns="3"] & {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .card-image {
            &--mobile {
                width: 410px;
                max-width: 100%;
                height: 100%;
            }

            &--desktop {
                width: 600px;
                max-width: 100%;
                height: 100%;
            }
        }
    }
</style>

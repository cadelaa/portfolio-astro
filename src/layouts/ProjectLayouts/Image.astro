---
import { Image as AstroImage } from "astro:assets";

export interface Props {
    desktopImage?: ImageMetadata;
    desktopImageAlt?: string;
    mobileImages?: { src: ImageMetadata; alt?: string }[];
}

const { desktopImage, desktopImageAlt, mobileImages } = Astro.props;

const hasMobile = mobileImages && mobileImages.length > 0;
const layout =
    desktopImage && hasMobile
        ? "side-by-side"
        : desktopImage
          ? "desktop-only"
          : "mobile-only";
---

<div class={`image-layout ${layout}`}>
    {
        desktopImage && (
            <div class="desktop-wrap">
                <AstroImage src={desktopImage} alt={desktopImageAlt ?? ""} />
            </div>
        )
    }
    {
        hasMobile && (
            <div class="mobile-wrap">
                {mobileImages?.map(({ src, alt }) => (
                    <AstroImage src={src} alt={alt ?? ""} />
                ))}
            </div>
        )
    }
</div>

<style lang="scss">
    .image-layout {
        display: flex;
        width: 100%;
        gap: var(--space-16);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .desktop-wrap {
        flex: 2;
        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
    }

    .mobile-wrap {
        display: flex;
        gap: var(--space-16);
        img {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }
    }

    .side-by-side .mobile-wrap {
        flex: 1;
    }
    .mobile-only .mobile-wrap {
        flex: 1;
    }
    .desktop-only .desktop-wrap {
        flex: 1;
    }
</style>

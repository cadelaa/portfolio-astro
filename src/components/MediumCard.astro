---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import Tag from "../components/Tag.astro";

export interface Props {
    title: string;
    tags?: string[];
    desktopImage?: string;
    mobileImages?: string[];
    showDesktopImage?: boolean;
    showMobileImages?: boolean;
    disabled?: boolean;
}

const {
    title,
    tags = [],
    desktopImage,
    mobileImages = [],
    showDesktopImage = true,
    showMobileImages = true,
    disabled = false,
} = Astro.props;
---

<card class="card" class:list={{ disabled }}>
    <div class="head-content">
        <h4 class="card-title">{title}</h4>
        {
            tags.length > 0 && (
                <div class="tag-group">
                    {tags.map((tag) => (
                        <Tag
                            label={tag}
                            bgColor="var(--tag-bg-default)"
                            bgHoverColor="var(--tag-bg-hover)"
                            tagTextColor="var(--tag-text)"
                        />
                    ))}
                </div>
            )
        }
    </div>
    {
        showMobileImages && (
            <div class="image-group">
                <div class="image" />
                <div class="image" />
            </div>
        )
    }

    {
        showDesktopImage && (
            <div class="image-group">
                <div class="image" />
            </div>
        )
    }
</card>

<style lang="scss">
    .card {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        padding: var(--space-32);
        overflow: hidden;
        height: 450px;
        background: var(--bg-default);
        color: var(--text-primary);
        border-radius: var(--radius-8);
        border: 1px solid var(--border-subtle);

        --tag-bg-default: var(--bg-secondary);
        --tag-bg-hover: var(--bg-secondary-hover);
        --tag-text: var(--text-secondary);

        transition:
            background-color 0.3s ease,
            border 0.3s ease;

        .head-content {
            display: flex;
            flex-direction: column;
            gap: var(--space-8);
        }

        .tag-group {
            display: flex;
            gap: var(--space-4);
            flex-wrap: wrap;
        }

        .image {
            background: var(--bg-secondary);
            width: 100%;
            height: 400px;
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            transform: translateY(var(--space-64));
            transition: transform 0.3s ease;
        }

        &:hover {
            background-color: var(--bg-default-hover);
            border: 1px solid var(--border-hover);

            --tag-bg-default: var(--bg-secondary-hover);
            --tag-bg-hover: var(--bg-secondary);

            .image {
                background-color: var(--bg-secondary-hover);
                border: 1px solid var(--border-hover);
                transform: translateY(0);
            }
        }

        .image-group {
            display: flex;
            gap: var(--space-16);
        }

        &.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
    }

    .card-title {
        margin: 0;
    }
</style>

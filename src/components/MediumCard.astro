---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";
import Tag from "../components/Tag.astro";

export interface Props {
    showMeasurableMetric?: boolean;
    measurableMetric: string;
    measurableMetricIcon?: string;

    title: string;
    tags?: string[];

    desktopImage?: string;
    mobileImages?: string[];
    showDesktopImage?: boolean;
    showMobileImages?: boolean;

    cardBackgroundHover?: string;
    tagBackgroundHover?: string;

    disabled?: boolean;
}

const {
    showMeasurableMetric = true,
    measurableMetricIcon,
    measurableMetric,

    title,
    tags = [],

    desktopImage,
    mobileImages = [],
    showDesktopImage = true,
    showMobileImages = true,

    cardBackgroundHover = "var(--bg-default-hover)",
    tagBackgroundHover = "var(--bg-secondary-hover)",

    disabled = false,
} = Astro.props;
---

<div
    class="medium-card"
    class:list={{ disabled }}
    style={`
        --card-bg-hover: ${cardBackgroundHover};
        --tag-bg-hover: ${tagBackgroundHover};
    `}
>
    <div class="head-content">
        {
            showMeasurableMetric && (
                <div class="measurable-metric">
                    <span class="material-symbols-outlined">
                        {measurableMetricIcon}
                    </span>
                    <span class="Body">{measurableMetric}</span>
                </div>
            )
        }
        <h4 class="card-title H4">{title}</h4>
        {
            tags.length > 0 && (
                <div class="tag-group">
                    {tags.map((tag) => (
                        <Tag
                            label={tag}
                            bgColor="var(--tag-bg-default)"
                            bgHoverColor="var(--tag-bg-hover)"
                            tagTextColor="var(--tag-text)"
                        />
                    ))}
                </div>
            )
        }
    </div>
    {
        showMobileImages && (
            <div class="image-group">
                <div class="image" />
                <div class="image" />
            </div>
        )
    }

    {
        showDesktopImage && (
            <div class="image-group">
                <div class="image" />
            </div>
        )
    }
</div>

<style lang="scss">
    .medium-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        padding: var(--space-32);
        overflow: hidden;
        height: 450px;
        background: var(--bg-default);
        color: var(--text-primary);
        border-radius: var(--radius-8);
        border: 1px solid var(--border-subtle);

        --tag-bg-default: var(--bg-secondary);
        --tag-text: var(--text-subtle);

        transition:
            background-color 0.3s ease,
            border 0.3s ease;

        &:hover {
            cursor: pointer;

            background-color: var(--card-bg-hover);
            border: 1px solid var(--border-hover);

            --tag-bg-default: var(--tag-bg-hover);
            --tag-text: var(--text-primary);

            .image {
                background-color: var(--bg-secondary-hover);
                border: 1px solid var(--border-hover);
                transform: translateY(0);
            }

            .measurable-metric {
                color: var(--text-primary);
            }
        }

        .head-content {
            display: flex;
            flex-direction: column;
            gap: var(--space-8);
        }

        .measurable-metric {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            color: var(--text-subtle);
        }

        .tag-group {
            display: flex;
            gap: var(--space-4);
            flex-wrap: wrap;
        }

        .image {
            background: var(--bg-secondary);
            width: 100%;
            height: 400px;
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            transform: translateY(var(--space-64));
            transition: transform 0.3s ease;
        }

        .image-group {
            display: flex;
            gap: var(--space-16);
        }

        &.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
    }

    .card-title {
        margin: 0;
    }

    .material-symbols-outlined {
        font-family: "Material Symbols Outlined";
        font-weight: bold;
        font-style: normal;
        font-size: 28px;
        /* Preferred icon size */
        display: inline-block;
        line-height: 1;
        text-transform: none;
        letter-spacing: normal;
        word-wrap: normal;
        white-space: nowrap;
        direction: ltr;
    }
</style>

---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";
import Tag from "../components/Tag.astro";

export interface Props {
    link?: string;

    showMeasurableMetric?: boolean;
    measurableMetric: string;
    measurableMetricIcon?: string;

    title: string;
    tags?: string[];

    desktopImage?: string;
    showDesktopImage?: boolean;
    desktopImageAlt?: string;

    mobileImages?: string[];
    showMobileImages?: boolean;
    mobileImageAlt?: string;

    cardBackgroundHover?: string;
    tagBackgroundHover?: string;

    disabled?: boolean;
}

const {
    link,

    showMeasurableMetric = true,
    measurableMetricIcon,
    measurableMetric,

    title,
    tags = [],

    desktopImage,
    showDesktopImage = true,
    desktopImageAlt,

    mobileImages = [],
    showMobileImages = true,
    mobileImageAlt,

    cardBackgroundHover = "var(--bg-default-hover)",
    tagBackgroundHover = "var(--bg-secondary-hover)",

    disabled = false,
} = Astro.props;
---

<a href={link} style="text-decoration: none; color: inherit;">
    <div
        class="medium-card"
        class:list={{ disabled }}
        style={`
        --card-bg-hover: ${cardBackgroundHover};
        --tag-bg-hover: ${tagBackgroundHover};
    `}
    >
        <div class="head-content">
            {
                showMeasurableMetric && (
                    <div class="measurable-metric">
                        <span class="material-symbols-outlined">
                            {measurableMetricIcon}
                        </span>
                        <span class="Body">{measurableMetric}</span>
                    </div>
                )
            }
            <h4 class="card-title H4">{title}</h4>
            {
                tags.length > 0 && (
                    <div class="tag-group">
                        {tags.map((tag) => (
                            <Tag
                                label={tag}
                                bgColor="var(--tag-bg-default)"
                                bgHoverColor="var(--tag-bg-hover)"
                                tagTextColor="var(--tag-text)"
                            />
                        ))}
                    </div>
                )
            }
        </div>
        {
            showMobileImages && mobileImages.length > 0 && (
                <div class="image-group">
                    {mobileImages.map((src, index) => (
                        <img
                            src={src}
                            alt={`${mobileImageAlt || title} – mobile screen`}
                            loading="lazy"
                            class="image mobileImages"
                        />
                    ))}
                </div>
            )
        }

        {
            showDesktopImage && desktopImage && (
                <div class="image-group">
                    <img
                        src={desktopImage}
                        alt={`${desktopImageAlt || title} – desktop preview`}
                        loading="lazy"
                        class="image"
                    />
                </div>
            )
        }
    </div>
</a>

<style lang="scss">
    .medium-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        padding: var(--space-24);
        overflow: hidden;
        height: 450px;
        background: var(--bg-default);
        color: var(--text-primary);
        border-radius: var(--radius-8);
        border: 1px solid var(--border-subtle);

        --tag-bg-default: var(--bg-secondary);
        --tag-text: var(--text-subtle);

        .head-content {
            display: flex;
            flex-direction: column;
            gap: var(--space-8);
        }

        .measurable-metric {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            color: var(--text-subtle);
        }

        .tag-group {
            display: flex;
            gap: var(--space-4);
            flex-wrap: wrap;
        }

        .image {
            width: 100%;
            height: 400px;
            justify-content: start;
            border: 1px solid var(--border-subtle);
            border-radius: 8px;

            object-fit: cover;
            object-position: top;
            display: block;

            &.mobileImages {
                border: none;
            }
        }

        .image-group {
            display: flex;
            gap: var(--space-16);
        }

        &.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
    }

    @media (min-width: 1120px) {
        .medium-card {
            display: flex;
            flex-direction: column;
            gap: var(--space-24);
            padding: var(--space-32);
            overflow: hidden;
            height: 450px;
            background: var(--bg-default);
            color: var(--text-primary);
            border-radius: var(--radius-8);
            border: 1px solid var(--border-subtle);

            --tag-bg-default: var(--bg-secondary);
            --tag-text: var(--text-subtle);

            transition: none;

            &:hover {
                cursor: pointer;

                background-color: var(--card-bg-hover);
                border: 1px solid var(--border-hover);

                --tag-bg-default: var(--tag-bg-hover);
                --tag-text: var(--text-primary);

                .image {
                    border: 1px solid var(--border-hover);
                    transform: translateY(0);
                    filter: grayscale(0);
                }

                .measurable-metric {
                    color: var(--text-primary);
                }
            }

            .head-content {
                display: flex;
                flex-direction: column;
                gap: var(--space-8);
            }

            .measurable-metric {
                display: flex;
                align-items: center;
                gap: var(--space-2);
                color: var(--text-subtle);
            }

            .tag-group {
                display: flex;
                gap: var(--space-4);
                flex-wrap: wrap;
            }

            .image {
                width: 100%;
                height: 400px;
                justify-content: start;
                border: 1px solid var(--border-subtle);
                border-radius: 8px;
                transform: translateY(var(--space-64));
                transition: transform 0.3s ease;

                filter: grayscale(1);

                object-fit: cover;
                object-position: top;
                display: block;

                &.mobileImages {
                    border: none;
                }
            }

            .image-group {
                display: flex;
                gap: var(--space-16);
            }

            &.disabled {
                opacity: 0.5;
                pointer-events: none;
            }
        }

        .card-title {
            margin: 0;
        }

        .material-symbols-outlined {
            font-family: "Material Symbols Outlined";
            font-weight: bold;
            font-style: normal;
            font-size: 28px;
            /* Preferred icon size */
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }
    }
</style>

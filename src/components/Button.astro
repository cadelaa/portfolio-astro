---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";

export interface Props {
    label?: string;
    disabled?: boolean;
    type?: "primary" | "secondary";
}

const { label = "Label", disabled = false, type = "primary" } = Astro.props;
---

<button class={`button ${type}`} disabled={disabled}>
    {label && <h5>{label}</h5>}
</button>

<style lang="scss">
    .button {
        display: inline-flex;
        align-items: center;
        gap: var(--space-4);

        border-radius: var(--radius-4);
        padding: var(--space-8);

        transition: background-color 0.3s ease;

        &:hover:not(:disabled) {
            background-color: var(--accent-primary-hover);
        }
    }

    .primary {
        background-color: var(--accent-primary);
        color: var(--text-alt);
        border: none;

        &:hover:not(:disabled) {
            background-color: var(--accent-primary-hover);
        }
    }

    .secondary {
        background-color: var(--bg-default);
        color: var(--text-primary);
        border: var(--border-subtle) 1px solid;

        &:hover:not(:disabled) {
            background-color: var(--bg-default-hover);
        }
    }

    .disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* 
        Consider adding icons to buttons at a later date? perhaps dont
        really need them or the option to need them etc 
    */
</style>

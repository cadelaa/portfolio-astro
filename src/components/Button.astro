---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";

export interface Props {
    type?: "primary" | "secondary";
    label?: string;
    link?: string;
    disabled?: boolean;
}

const {
    label = "Label",
    disabled = false,
    link = "#",
    type = "primary",
} = Astro.props;
---

<a
    class={`button ${type} ${disabled ? "disabled" : ""}`}
    href={disabled ? undefined : link}
    aria-disabled={disabled}
>
    {label && <span class="H6">{label}</span>}
</a>

<style lang="scss">
    .button {
        display: inline-flex;
        align-items: center;
        gap: var(--space-4);

        border-radius: var(--radius-4);
        padding: var(--space-8);
        text-decoration: none;

        transition: background-color 0.3s ease;

        &:hover {
            cursor: pointer;
        }

        &.disabled {
            opacity: 0.5;
            cursor: not-allowed;
            pointer-events: none; // 🚨 this actually disables clicks
        }
    }

    .primary {
        background-color: var(--accent-primary);
        color: var(--text-alt);

        &:hover:not(.disabled) {
            background-color: var(--accent-primary-hover);
        }
    }

    .secondary {
        background-color: var(--bg-default);
        color: var(--text-primary);
        border: var(--border-subtle) 1px solid;

        &:hover:not(.disabled) {
            background-color: var(--bg-default-hover);
        }
    }

    /* 
        Consider adding icons to buttons at a later date? perhaps dont
        really need them or the option to need them etc 
    */
</style>

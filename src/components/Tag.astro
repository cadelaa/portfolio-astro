---
import "../styles/typography.css";
import "../styles/spacing.css";
import "../styles/colors.css";

export interface Props {
    label: string;
    bgColor?: string;
    bgHoverColor?: string;
    tagTextColor?: string;
}

const {
    label,
    bgColor = "var(--tag-bg-default)",
    bgHoverColor = "var(--tag-bg-default-hover)",
    tagTextColor = "var(--tag-text)",
} = Astro.props;
---

<div
    class="tag-container"
    style={`
    --tag-bg: ${bgColor};
    --tag-bg-hover: ${bgHoverColor};
    --tag-text: ${tagTextColor};
  `}
>
    <span class="Tag">{label}</span>
</div>

<style lang="scss">
    .tag-container {
        display: inline-block;
        padding: 0 var(--space-4);
        background-color: var(--tag-bg);
        border-radius: var(--radius-4);

        /* 🔑 THIS FIXES THE “FUNKY” FEEL */
        transition: background-color 0.25s ease;
    }

    .tag-container .Tag {
        color: var(--tag-text);
        transition: color 0.25s ease;
    }
</style>

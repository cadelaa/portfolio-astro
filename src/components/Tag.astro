---
import "../styles/typography.css";
import "../styles/spacing.css";
import "../styles/colors.css";

export interface Props {
    label: string;
    bgColor?: string;
    tagTextColor?: string;
}

const {
    label,
    bgColor = "var(--tag-bg-default)",
    tagTextColor = "var(--tag-text)",
} = Astro.props;
---

<div
    class="tag-container"
    style={`
    --tag-bg: ${bgColor};
    --tag-text: ${tagTextColor};
  `}
>
    <span class="Tag">{label}</span>
</div>

<style lang="scss">
    .tag-container {
        display: inline-block;
        padding: 0 var(--space-4);
        background-color: var(--tag-bg);
        border-radius: var(--radius-4);
    }

    /* IMPORTANT: apply color to the text element */
    .tag-container .Tag {
        color: var(--tag-text);
    }
</style>

---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";
import GitHub_Invertocat_Black from "../assets/logos/GitHub_Invertocat_Black.svg?raw";
import linkedin_logo from "../assets/logos/linkedin_logo.svg?raw";
import mitchell_zeller from "../assets/logos/mitchell_zeller.png";

export interface Props {
    hasLogo?: boolean;
    hasBackLink?: boolean;

    backLink?: string;
    backLabel?: string;
}

const { hasLogo, hasBackLink, backLink, backLabel } = Astro.props;
---

<nav class="nav-container">
    <div class="dynamic-link">
        {
            hasBackLink && (
                <a class="H6 link-item" href={backLink}>
                    <span class="material-symbols-outlined"> arrow_back </span>
                    <span class="label"> {backLabel} </span>
                </a>
            )
        }

        {
            hasLogo && (
                <a class="H6 link-item">
                    <img
                        src={mitchell_zeller.src}
                        width={mitchell_zeller.width}
                        height={mitchell_zeller.height}
                        alt="mitchell zeller logo"
                        loading="lazy"
                        class="mitchell-zeller"
                    />
                    <span class="label"> Mitchell Zeller </span>
                </a>
            )
        }
    </div>
    <div class="nav-links">
        <a href="/work/" class="H6 link-item">Work</a>
        <a href="/about/" class="H6 link-item">About</a>
        <a href="/fun/" class="H6 link-item">Fun</a>
        <a
            href="https://drive.google.com/file/d/1nCjSYx6c7nbBBu6GfO34sLEu3xaOe-7R/view?usp=sharing"
            target="_blank"
            rel="noopener noreferrer"
            class="H6 link-item">Resume</a
        >
    </div>
    <div class="social-links">
        <a
            href="https://www.linkedin.com/in/mitchell-zeller"
            target="_blank"
            rel="noopener noreferrer"
            class="H6 link-item social-link-item logo"
            set:html={linkedin_logo}
        />
        <a
            href="https://github.com/cadelaa"
            target="_blank"
            rel="noopener noreferrer"
            class="H6 link-item social-link-item logo"
            set:html={GitHub_Invertocat_Black}
        />
        <a class="H6 link-item social-link-item">☀</a>
    </div>
</nav>

<style lang="scss">
    .nav-container {
        display: flex;
        position: sticky;
        top: 0;
        align-items: center;
        justify-content: space-between;
        background: var(--bg-page);
        padding: var(--space-12) 64px;
        z-index: 100;
    }

    .nav-links {
        position: absolute;
        left: 0;
        right: 0;
        margin-inline: auto;
        width: fit-content;
        display: flex;
        gap: var(--space-4);
    }

    .social-links {
        display: flex;
        gap: var(--space-4);
    }

    .link-item {
        display: flex;
        align-items: center;
        height: 16px;
        padding: var(--space-8) var(--space-6);
        color: var(--text-subtle);
        text-decoration: none;
        transition: color 0 ease;
        border-radius: var(--radius-8);

        &:hover {
            background-color: var(--bg-default);
            cursor: pointer;
            color: var(--text-primary);
        }
    }

    .social-link-item {
        padding: var(--space-8);
    }

    .label {
        padding: 0 var(--space-2);
    }

    .dynamic-link {
        display: flex;
    }

    .logo {
        display: flex;
        margin: 0;
        width: 20px;
        height: 20px;
    }

    .mitchell-zeller {
        display: flex;
        height: 28px;
        width: 28px;
        margin: 0;
    }

    .material-symbols-outlined {
        font-family: "Material Symbols Outlined";
        font-weight: 1000;
        font-style: normal;
        font-size: 28px;
        display: inline-block;
        line-height: 1;
        text-transform: none;
        letter-spacing: normal;
        word-wrap: normal;
        white-space: nowrap;
        direction: ltr;
    }
</style>

---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";
import Tag from "../components/Tag.astro";

export interface Props {
    layout?: "overview" | "showcase" | "default";
    title: string;
    description?: string;

    tagLabel?: string;
}

const { layout } = Astro.props;
---

<div>
    class={`project project--${layout}`}>
    {layout === "overview" && <Overview {...Astro.props} />}
    {layout === "showcase" && <Showcase {...Astro.props} />}
    {layout === "default" && <Default {...Astro.props} />}
</div>

<style lang="scss">
    .red {
        background: red;
    }

    .blue {
        background: blue;
    }

    .yellow {
        background: yellow;
    }
</style>

--- .overview {
    /* 
        This is used at the top of the project page, including the roles, timeline, tools etc. Already have
        and example in /portfolio/design/ to use.
        */
}

.default {
    /* 
        This is the default layout, ideally I want to make it as versatile as possible, for example
        the .one-image & .two-images could be included here, by simply including a show/hide bool prop for
        this specific variant.
        */
}

.one-image {
    /* 
        This is a default layout with one image included to support it. This may not be necessary
        */
}

.two-images {
    /* 
        This is a default layout with one two images to support it. This may not be necessary
        */
}

.showcase {
    /* 
        This is a layout used to showcase core features of the given project, typically found
        towards the bottom of the project. For example the light/dark mode switch in my portfolio
        would be showcased with this layout.
        */
}

.reusable-classes {
    /* 
        For example, in all the layouts I want to most likely use, .head-content, .main-content, and .footer-content
        if I am able to. Some layouts like the showcase may require extra special classes to ensure the layout of 
        elements is correct.
        */
}

/* I also need to consider making all of these responsive as it should be quite
easy, would simply be changing the padding from 64 to 32 to 16 for large,
medium, and small screens, but also changing the flex direction from row to
column etc. */

---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";
import Tag from "../components/Tag.astro";

export interface Props {
    icon: string;
    title: string;
    tags?: string[];
    description: string;
    disabled?: boolean;
    link?: string;
}

const {
    icon,
    title,
    tags = [],
    description,
    disabled = false,
    link,
} = Astro.props;
---

<a
    href={disabled ? undefined : link}
    style="text-decoration: none; color: inherit;"
    class:list={["card-link", { disabled }]}
>
    <div class="small-card">
        <div class="head-content">
            <div class="title">
                <span class="material-symbols-outlined icon-hover">{icon}</span>
                <span class="card-title H4">{title}</span>
            </div>
            {
                tags.length > 0 && (
                    <div class="tag-group">
                        {tags.map((tag) => (
                            <Tag
                                label={tag}
                                bgColor="var(--tag-bg-default)"
                                bgHoverColor="var(--tag-bg-hover)"
                                tagTextColor="var(--tag-text)"
                            />
                        ))}
                    </div>
                )
            }
        </div>
        <span class="Body">{description}</span>
    </div>
</a>

<style lang="scss">
    .card-link {
        display: block;

        &.disabled {
            opacity: 0.5;
            pointer-events: none;
            cursor: default;
        }
    }

    .small-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        padding: var(--space-24);
        overflow: hidden;
        background: var(--bg-default);
        color: var(--text-subtle);
        border-radius: var(--radius-8);
        border: 1px solid var(--border-subtle);

        --tag-bg-default: var(--bg-secondary);
        --tag-text: var(--text-subtle);

        transition: none;

        .head-content {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: var(--space-8);

            .title {
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: var(--space-4);
            }
        }

        .tag-group {
            display: flex;
            gap: var(--space-2);
            flex-wrap: wrap;
            align-items: center;
        }

        .image-group {
            display: flex;
            gap: var(--space-16);
        }
    }

    .card-title {
        margin: 0;
    }

    @media (min-width: 1120px) {
        .small-card {
            padding: var(--space-32);

            transition:
                color 0.3s ease,
                background-color 0.3s ease,
                border-color 0.3s ease;

            &:hover {
                cursor: pointer;
                background-color: var(--bg-default-hover);
                border: 1px solid var(--border-hover);
                color: var(--text-primary);
                --tag-bg-default: var(--bg-secondary-hover);
            }
        }

        .material-symbols-outlined {
            font-size: 2rem;
        }
    }
</style>

---
import "../styles/colors.css";
import "../styles/spacing.css";
import "../styles/radius.css";
import "../styles/typography.css";
import Tag from "../components/Tag.astro";

export interface Props {
    icon: string;
    title: string;
    tags?: string[];
    description: string;
    disabled?: boolean;
    link?: string;
}

const {
    icon,
    title,
    tags = [],
    description,
    disabled = false,
    link,
} = Astro.props;
---

<a href={link} style="text-decoration: none; color: inherit;">
    <div class="medium-card" class:list={{ disabled }}>
        <div class="head-content">
            <div class="title">
                <span class="material-symbols-outlined">{icon}</span>
                <span class="card-title H4">{title}</span>
            </div>
            {
                tags.length > 0 && (
                    <div class="tag-group">
                        {tags.map((tag) => (
                            <Tag
                                label={tag}
                                bgColor="var(--tag-bg-default)"
                                bgHoverColor="var(--tag-bg-hover)"
                                tagTextColor="var(--tag-text)"
                            />
                        ))}
                    </div>
                )
            }
        </div>
        <span class="Body">{description}</span>
    </div>
</a>

<style lang="scss">
    .medium-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        padding: var(--space-24);
        overflow: hidden;
        background: var(--bg-default);
        color: var(--text-subtle);
        border-radius: var(--radius-8);
        border: 1px solid var(--border-subtle);

        --tag-bg-default: var(--bg-secondary);
        --tag-text: var(--text-subtle);

        transition: none;

        .head-content {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: var(--space-8);

            .title {
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: var(--space-4);
            }
        }

        .tag-group {
            display: flex;
            gap: var(--space-2);
            flex-wrap: wrap;
            align-items: center;
        }

        .image {
            background: var(--bg-secondary);
            width: 100%;
            height: 400px;
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            transform: translateY(var(--space-64));
            transition: transform 0.3s ease;
        }

        .image-group {
            display: flex;
            gap: var(--space-16);
        }

        &.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
    }

    .card-title {
        margin: 0;
    }

    .material-symbols-outlined {
        font-family: "Material Symbols Outlined";
        font-weight: bold;
        font-style: normal;
        font-size: 36px;
        /* Preferred icon size */
        display: inline-block;
        line-height: 1;
        text-transform: none;
        letter-spacing: normal;
        word-wrap: normal;
        white-space: nowrap;
        direction: ltr;
    }

    @media (min-width: 1120px) {
        .medium-card {
            display: flex;
            flex-direction: column;
            gap: var(--space-8);
            padding: var(--space-32);
            overflow: hidden;
            background: var(--bg-default);
            color: var(--text-subtle);
            border-radius: var(--radius-8);
            border: 1px solid var(--border-subtle);

            --tag-bg-default: var(--bg-secondary);
            --tag-text: var(--text-subtle);

            transition:
                color 0.3s ease,
                background-color 0.3s ease,
                border-color 0.3s ease;

            .head-content {
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: var(--space-8);

                .title {
                    display: flex;
                    flex-direction: row;
                    align-items: center;
                    gap: var(--space-4);
                }
            }

            .tag-group {
                display: flex;
                gap: var(--space-2);
                flex-wrap: wrap;
                align-items: center;
            }

            .image {
                background: var(--bg-secondary);
                width: 100%;
                height: 400px;
                border: 1px solid var(--border-subtle);
                border-radius: 8px;
                transform: translateY(var(--space-64));
                transition: transform 0.3s ease;
            }

            &:hover {
                cursor: pointer;

                background-color: var(--bg-default-hover);
                border: 1px solid var(--border-hover);
                color: var(--text-primary);

                --tag-bg-default: var(--bg-secondary-hover);

                .image {
                    background-color: var(--bg-secondary-hover);
                    border: 1px solid var(--border-hover);
                    transform: translateY(0);
                }
            }

            .image-group {
                display: flex;
                gap: var(--space-16);
            }

            &.disabled {
                opacity: 0.5;
                pointer-events: none;
            }
        }

        .card-title {
            margin: 0;
        }

        .material-symbols-outlined {
            font-family: "Material Symbols Outlined";
            font-weight: bold;
            font-style: normal;
            font-size: 36px;
            /* Preferred icon size */
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }
    }
</style>
